{
  "name": "azure-sas-token",
  "version": "0.0.47",
  "author": "Avraham Hamu",
  "description": "Generate Shared Access Signature (SAS) tokens for any Azure service (Service Bus, Event Hubs, Storage, IoT Hub, Relay) in Node.js.",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "typecheck": "tsc -p . --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "build": "npm run clean && npm run lint && tsc -p . --pretty",
    "compile:dev": "tsc -p . --pretty -w",
    "prepublishOnly": "npm test && npm run build",
    "patch": "npm version patch",
    "publish": "npm publish",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.15.3",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "azure",
    "sas",
    "token",
    "shared access signature",
    "cloud"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ah584d/azure-sas-token.git"
  }
}
